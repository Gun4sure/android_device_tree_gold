cc_binary {
    name: "android.hardware.audio.parameter_parser.service",
    system_ext_specific: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.audio.parameter_parser.service.rc"],
    defaults: ["latest_android_hardware_audio_core_ndk_shared"],
    srcs: [
        "ParameterParser.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "av-audio-types-aidl-ndk",
        "libbase",
        "libbinder_ndk",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
